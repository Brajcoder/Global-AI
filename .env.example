# Everything here is optional. With nothing set the app runs in offline demo mode.

# --- Default LLM: any OpenAI-compatible endpoint ---------------------------------------------
# Option A: spell out the connection (works with every provider).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Option B: use a built-in preset and just supply its key. Ignored when LLM_BASE_URL is set.
# Presets: openai, groq, gemini, openrouter, together, deepseek, mistral, ollama, lmstudio, bifrost
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
# Bifrost (or any other gateway) is used through the "bifrost" preset.
BIFROST_GATEWAY_URL=http://localhost:8080/v1
BIFROST_API_KEY=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Judge claim-vs-evidence stance with the default LLM (heuristics are used when no LLM is set).
LLM_JUDGE_ENABLED=true

# --- Tavily research provider ------------------------------------------------------------------
TAVILY_API_KEY=
TAVILY_CACHE_ENABLED=true
TAVILY_CACHE_DB_PATH=./data/tavily_cache.sqlite
# Cached results older than this are re-fetched (keeps "live" verification live)
TAVILY_CACHE_TTL_HOURS=24
# basic = 1 credit/search, advanced = 2 credits/search
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=3

# --- Database (relative SQLite paths resolve against the project root; ./data is created automatically)
# Postgres/Supabase example: postgresql+psycopg://user:pass@host:5432/postgres  (needs psycopg in requirements)
DATABASE_URL=sqlite:///./data/chronos_veritygate.db

# --- Verification & benchmark policies -----------------------------------------------------------
VERIFICATION_DEFAULT_MODE=advisory
MAX_CLAIMS_PER_REQUEST=10
MAX_SEARCHES_PER_CLAIM=3
MAX_AGENT_STEPS_PER_TASK=10
REQUEST_TIMEOUT_SECONDS=20

# --- Security ----------------------------------------------------------------------------------
# When set, every POST/DELETE endpoint requires the header "X-API-Key: <value>".
API_KEY=
# Comma-separated browser origins allowed to call the API, or * for any.
CORS_ALLOW_ORIGINS=*
