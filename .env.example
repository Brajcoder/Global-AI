# Bifrost Gateway & LLM Routing
BIFROST_GATEWAY_URL=http://localhost:8080/v1
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile

# Tavily Research Provider
TAVILY_API_KEY=
TAVILY_CACHE_ENABLED=true
TAVILY_CACHE_DB_PATH=./data/tavily_cache.sqlite

# Database
DATABASE_URL=sqlite:///./data/chronos_veritygate.db

# Verification & Benchmark Policies
VERIFICATION_DEFAULT_MODE=advisory
MAX_CLAIMS_PER_REQUEST=10
MAX_SEARCHES_PER_CLAIM=3
MAX_AGENT_STEPS_PER_TASK=10
REQUEST_TIMEOUT_SECONDS=20
