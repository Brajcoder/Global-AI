# Bifrost Gateway & LLM Routing
BIFROST_GATEWAY_URL=http://localhost:8080/v1
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile

# Tavily Research Provider
TAVILY_API_KEY=
TAVILY_CACHE_ENABLED=true
TAVILY_CACHE_DB_PATH=./data/tavily_cache.sqlite
# Cached results older than this are re-fetched (keeps "live" verification live)
TAVILY_CACHE_TTL_HOURS=24
# basic = 1 credit/search, advanced = 2 credits/search
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=3

# Database (relative SQLite paths resolve against the project root; ./data is created automatically)
# Postgres/Supabase example: postgresql+psycopg://user:pass@host:5432/postgres  (needs psycopg in requirements)
DATABASE_URL=sqlite:///./data/chronos_veritygate.db

# Verification & Benchmark Policies
VERIFICATION_DEFAULT_MODE=advisory
MAX_CLAIMS_PER_REQUEST=10
MAX_SEARCHES_PER_CLAIM=3
MAX_AGENT_STEPS_PER_TASK=10
REQUEST_TIMEOUT_SECONDS=20
